generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

model User {
  id                  String             @id @default(uuid())
  email               String?            @unique
  passwordHash        String             @map("password_hash")
  firstName           String             @map("first_name")
  lastName            String             @map("last_name")
  role                String
  institution         String?
  isVerified          Boolean            @default(false) @map("is_verified")
  createdAt           DateTime           @default(now()) @map("created_at")
  updatedAt           DateTime           @updatedAt @map("updated_at")
  banReason           String?            @map("ban_reason")
  isBanned            Boolean            @default(false) @map("is_banned")
  isWarned            Boolean            @default(false) @map("is_warned")
  warningDate         DateTime?          @map("warning_date")
  warningMessage      String?            @map("warning_message")
  bio                 String?
  resetToken          String?            @map("reset_token")
  resetTokenExpiry    DateTime?          @map("reset_token_expiry")
  accounts            Account[]
  advertisements      Advertisement[]    @relation("AdCreator")
  announcements       Announcement[]     @relation("AnnouncementCreator")
  bookmarks           Bookmark[]
  revokedCertificates Certificate[]      @relation("CertificateRevoker")
  certificates        Certificate[]      @relation("UserCertificates")
  conferences         Conference[]       @relation("ConferenceCreator")
  downloads           Download[]
  ebook_purchases     ebook_purchases[]
  ebook_views         ebook_views[]
  ebooks              ebook[]
  paperAuthors        PaperAuthor[]
  submittedPapers     Paper[]            @relation("PaperSubmitter")
  plagiarismChecks    PlagiarismCheck[]  @relation("PlagiarismChecker")
  assignedReviews     ReviewAssignment[] @relation("AssignedByUser")
  reviewerAssignments ReviewAssignment[] @relation("ReviewerAssignments")
  reviews             Review[]
  sessions            Session[]
  supportTickets      SupportTicket[]
  ticketReplies       TicketReply[]
  impactFactors       ImpactFactor[]     @relation("ImpactFactorCreator")
  siteAccess          UserSiteAccess[]
  crossrefDeposits    CrossrefDeposit[]
  crossrefLogs        CrossrefLog[]

  @@index([email])
  @@index([role])
  @@map("users")
}

model Issue {
  id          String   @id @default(uuid())
  title       String
  description String?
  volume      String
  issueNumber String   @map("issue_number")
  year        Int
  publishDate DateTime @map("publish_date")
  coverImage  String?  @map("cover_image")
  isPublished Boolean  @default(false) @map("is_published")
  createdAt   DateTime @default(now()) @map("created_at")
  updatedAt   DateTime @updatedAt @map("updated_at")
  papers      Paper[]

  siteId String? @map("site_id")
  site   Site?   @relation(fields: [siteId], references: [id])

  @@unique([volume, issueNumber])
  @@index([siteId])
  @@index([year])
  @@index([publishDate])
  @@index([isPublished])
  @@map("issues")
}

model Paper {
  id                String             @id @default(uuid())
  title             String
  abstract          String
  keywords          String?
  filePath          String             @map("file_path")
  status            String             @default("SUBMITTED")
  category          String?
  submittedAt       DateTime           @default(now()) @map("submitted_at")
  publishedAt       DateTime?          @map("published_at")
  submitterId       String             @map("submitter_id")
  coverImage        String?            @map("cover_image")
  issueNumber       String?            @map("issue_number")
  publicationDate   DateTime?          @map("publication_date")
  uniqueNumber      String?            @map("unique_number")
  volumeNumber      String?            @map("volume_number")
  issueId           String?            @map("issue_id")
  doi               String?
  doiStatus         String?            @default("PENDING") @map("doi_status")
  doiRegisteredAt   DateTime?          @map("doi_registered_at")
  crossrefMetadata  String?            @map("crossref_metadata")
  scribdUrl         String?            @map("scribd_url")
  archivePapers     ArchivePaper[]
  bookmarks         Bookmark[]
  certificates      Certificate[]
  citations         Citation[]
  downloads         Download[]
  paperAuthors      PaperAuthor[]
  issue             Issue?             @relation(fields: [issueId], references: [id])
  submitter         User               @relation("PaperSubmitter", fields: [submitterId], references: [id])
  plagiarismChecks  PlagiarismCheck[]
  reviewAssignments ReviewAssignment[]
  reviews           Review[]
  paperContent      PaperContent?

  siteId String? @map("site_id")
  site   Site?   @relation(fields: [siteId], references: [id])
  
  crossrefDeposit     CrossrefDeposit?
  crossrefXmlVersions CrossrefXmlVersion[]

  @@index([siteId])
  @@index([submitterId])
  @@index([status])
  @@index([category])
  @@index([publishedAt])
  @@index([issueId])
  @@index([volumeNumber])
  @@index([issueNumber])
  @@index([publicationDate])
  @@index([uniqueNumber])
  @@index([doi])
  @@index([doiStatus])
  @@map("papers")
}

model Review {
  id             String    @id @default(uuid())
  paperId        String    @map("paper_id")
  reviewerId     String    @map("reviewer_id")
  comments       String?
  score          Int?
  recommendation String
  submittedAt    DateTime? @map("submitted_at")
  deadline       DateTime
  paper          Paper     @relation(fields: [paperId], references: [id])
  reviewer       User      @relation(fields: [reviewerId], references: [id])

  @@index([paperId])
  @@index([reviewerId])
  @@index([deadline])
  @@map("reviews")
}

model ReviewAssignment {
  id           String    @id @default(uuid())
  paperId      String    @map("paper_id")
  reviewerId   String    @map("reviewer_id")
  assignedById String    @map("assigned_by_id")
  assignedAt   DateTime  @default(now()) @map("assigned_at")
  dueDate      DateTime  @map("due_date")
  status       String    @default("ASSIGNED")
  completedAt  DateTime? @map("completed_at")
  assignedBy   User      @relation("AssignedByUser", fields: [assignedById], references: [id])
  paper        Paper     @relation(fields: [paperId], references: [id])
  reviewer     User      @relation("ReviewerAssignments", fields: [reviewerId], references: [id])

  @@unique([paperId, reviewerId])
  @@index([paperId])
  @@index([reviewerId])
  @@index([assignedById])
  @@index([dueDate])
  @@map("review_assignments")
}

model PaperAuthor {
  id              String  @id @default(uuid())
  paperId         String  @map("paper_id")
  userId          String  @map("user_id")
  authorOrder     Int     @map("author_order")
  isCorresponding Boolean @default(false) @map("is_corresponding")
  paper           Paper   @relation(fields: [paperId], references: [id])
  user            User    @relation(fields: [userId], references: [id])

  @@unique([paperId, authorOrder])
  @@index([paperId])
  @@index([userId])
  @@map("paper_authors")
}

model Download {
  id           String   @id @default(uuid())
  paperId      String   @map("paper_id")
  userId       String?  @map("user_id")
  downloadedAt DateTime @default(now()) @map("downloaded_at")
  ipAddress    String?  @map("ip_address")
  paper        Paper    @relation(fields: [paperId], references: [id])
  user         User?    @relation(fields: [userId], references: [id])

  @@index([paperId])
  @@index([userId])
  @@index([downloadedAt])
  @@map("downloads")
}

model Bookmark {
  id        String   @id @default(uuid())
  paperId   String   @map("paper_id")
  userId    String   @map("user_id")
  createdAt DateTime @default(now()) @map("created_at")
  paper     Paper    @relation(fields: [paperId], references: [id])
  user      User     @relation(fields: [userId], references: [id])

  @@unique([paperId, userId])
  @@index([paperId])
  @@index([userId])
  @@map("bookmarks")
}

model Account {
  id                String  @id @default(uuid())
  userId            String  @map("user_id")
  type              String
  provider          String
  providerAccountId String  @map("provider_account_id")
  refresh_token     String?
  access_token      String?
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String?
  session_state     String?
  user              User    @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
  @@index([userId], map: "accounts_user_id_fkey")
  @@map("accounts")
}

model Session {
  id           String   @id @default(uuid())
  sessionToken String   @unique @map("session_token")
  userId       String   @map("user_id")
  expires      DateTime
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId], map: "sessions_user_id_fkey")
  @@map("sessions")
}

model VerificationToken {
  identifier String
  token      String   @unique
  expires    DateTime

  @@unique([identifier, token])
  @@map("verificationtokens")
}

model PaperContent {
  id               String   @id @default(uuid())
  paperId          String   @unique @map("paper_id")
  introduction     String?
  literatureReview String?  @map("literature_review")
  methodology      String?
  results          String?
  discussion       String?
  conclusion       String?
  references       String?
  images           String? // Store array of image URLs and their metadata
  createdAt        DateTime @default(now()) @map("created_at")
  updatedAt        DateTime @updatedAt @map("updated_at")
  paper            Paper    @relation(fields: [paperId], references: [id], onDelete: Cascade)

  @@index([paperId])
  @@map("paper_contents")
}

model Conference {
  id          String   @id @default(uuid())
  title       String
  description String?
  startDate   DateTime @map("start_date")
  endDate     DateTime @map("end_date")
  location    String?
  venue       String?
  website     String?
  status      String   @default("UPCOMING")
  isPublic    Boolean  @default(true) @map("is_public")
  createdAt   DateTime @default(now()) @map("created_at")
  updatedAt   DateTime @updatedAt @map("updated_at")
  createdBy   String   @map("created_by")
  videoUrl    String?  @map("video_url")
  creator     User     @relation("ConferenceCreator", fields: [createdBy], references: [id])

  siteId String? @map("site_id")
  site   Site?   @relation(fields: [siteId], references: [id])

  @@index([siteId])
  @@index([startDate])
  @@index([endDate])
  @@index([status])
  @@index([isPublic])
  @@index([createdBy], map: "conferences_created_by_fkey")
  @@map("conferences")
}

model PlagiarismCheck {
  id          String   @id @default(uuid())
  paperId     String   @map("paper_id")
  checkResult String
  similarity  Float
  sources     String?
  status      String   @default("PENDING")
  checkedAt   DateTime @default(now()) @map("checked_at")
  checkedBy   String?  @map("checked_by")
  checker     User?    @relation("PlagiarismChecker", fields: [checkedBy], references: [id])
  paper       Paper    @relation(fields: [paperId], references: [id])

  @@index([paperId])
  @@index([status])
  @@index([checkedBy], map: "plagiarism_checks_checked_by_fkey")
  @@map("plagiarism_checks")
}

model Advertisement {
  id          String    @id @default(uuid())
  title       String
  description String?
  mediaUrl    String?   @map("media_url")
  mediaType   String?   @map("media_type")
  linkUrl     String?   @map("link_url")
  isEnabled   Boolean   @default(false) @map("is_enabled")
  position    String    @default("HOMEPAGE")
  priority    Int       @default(0)
  startDate   DateTime? @map("start_date")
  endDate     DateTime? @map("end_date")
  createdAt   DateTime  @default(now()) @map("created_at")
  updatedAt   DateTime  @updatedAt @map("updated_at")
  createdBy   String    @map("created_by")
  creator     User      @relation("AdCreator", fields: [createdBy], references: [id])

  @@index([isEnabled])
  @@index([position])
  @@index([priority])
  @@index([startDate])
  @@index([endDate])
  @@index([createdBy], map: "advertisements_created_by_fkey")
  @@map("advertisements")
}

model Announcement {
  id             String    @id @default(uuid())
  title          String
  content        String
  type           String    @default("GENERAL")
  priority       String    @default("NORMAL")
  isPublished    Boolean   @default(false) @map("is_published")
  publishedAt    DateTime? @map("published_at")
  expiresAt      DateTime? @map("expires_at")
  createdAt      DateTime  @default(now()) @map("created_at")
  updatedAt      DateTime  @updatedAt @map("updated_at")
  createdBy      String    @map("created_by")
  targetAudience String    @default("ALL") @map("target_audience")
  creator        User      @relation("AnnouncementCreator", fields: [createdBy], references: [id])

  siteId String? @map("site_id")
  site   Site?   @relation(fields: [siteId], references: [id])

  @@index([siteId])
  @@index([isPublished])
  @@index([type])
  @@index([priority])
  @@index([targetAudience])
  @@index([publishedAt])
  @@index([expiresAt])
  @@index([createdBy], map: "announcements_created_by_fkey")
  @@map("announcements")
}

model Visitor {
  id          String   @id @default(uuid())
  ipAddress   String   @map("ip_address")
  country     String?
  countryCode String?  @map("country_code")
  city        String?
  region      String?
  userAgent   String?  @map("user_agent")
  referer     String?
  page        String
  visitedAt   DateTime @default(now()) @map("visited_at")
  sessionId   String?  @map("session_id")

  @@index([country])
  @@index([countryCode])
  @@index([visitedAt])
  @@index([page])
  @@index([sessionId])
  @@map("visitors")
}

model Certificate {
  id                String    @id @default(uuid())
  paperId           String?   @map("paper_id")
  userId            String?   @map("user_id")
  certificateNumber String    @unique @map("certificate_number")
  type              String    @default("PUBLICATION")
  title             String
  authorName        String    @map("author_name")
  institution       String?
  topic             String?
  prize             String?
  issuedAt          DateTime  @default(now()) @map("issued_at")
  customDate        DateTime? @map("custom_date")
  pdfPath           String?   @map("pdf_path")
  isValid           Boolean   @default(true) @map("is_valid")
  revokedAt         DateTime? @map("revoked_at")
  revokedBy         String?   @map("revoked_by")
  paper             Paper?    @relation(fields: [paperId], references: [id])
  revoker           User?     @relation("CertificateRevoker", fields: [revokedBy], references: [id])
  user              User?     @relation("UserCertificates", fields: [userId], references: [id])

  @@index([paperId])
  @@index([userId])
  @@index([certificateNumber])
  @@index([type])
  @@index([issuedAt])
  @@index([isValid])
  @@index([revokedBy], map: "certificates_revoked_by_fkey")
  @@map("certificates")
}

model SEOConfig {
  id                 String   @id @default(uuid())
  page               String   @unique
  title              String
  description        String
  keywords           String?
  ogTitle            String?  @map("og_title")
  ogDescription      String?  @map("og_description")
  ogImage            String?  @map("og_image")
  twitterTitle       String?  @map("twitter_title")
  twitterDescription String?  @map("twitter_description")
  twitterImage       String?  @map("twitter_image")
  canonicalUrl       String?  @map("canonical_url")
  robots             String?  @default("index, follow")
  createdAt          DateTime @default(now()) @map("created_at")
  updatedAt          DateTime @updatedAt @map("updated_at")

  @@index([page])
  @@map("seo_configs")
}

model MaintenanceSettings {
  id                       String    @id @default(uuid())
  isMaintenanceMode        Boolean   @default(false) @map("is_maintenance_mode")
  maintenanceCode          String?   @map("maintenance_code")
  maintenanceMessage       String?   @map("maintenance_message")
  maintenanceStartTime     DateTime? @map("maintenance_start_time")
  maintenanceEndTime       DateTime? @map("maintenance_end_time")
  createdAt                DateTime  @default(now()) @map("created_at")
  updatedAt                DateTime  @updatedAt @map("updated_at")
  requireEmailVerification Boolean   @default(true) @map("require_email_verification")

  @@map("maintenance_settings")
}

model Citation {
  id         String    @id @default(uuid())
  paperId    String    @map("paper_id")
  style      String    @default("APA")
  content    String
  doi        String?
  url        String?
  accessDate DateTime? @map("access_date")
  createdAt  DateTime  @default(now()) @map("created_at")
  updatedAt  DateTime  @updatedAt @map("updated_at")
  paper      Paper     @relation(fields: [paperId], references: [id], onDelete: Cascade)

  @@index([paperId])
  @@index([style])
  @@map("citations")
}

model EditorialBoardMember {
  id           String   @id @default(uuid())
  name         String
  title        String?
  institution  String?
  email        String?
  bio          String?
  expertise    String?
  imageUrl     String?  @map("image_url")
  position     String   @default("MEMBER")
  displayOrder Int      @default(0) @map("display_order")
  isActive     Boolean  @default(true) @map("is_active")
  joinedAt     DateTime @default(now()) @map("joined_at")
  createdAt    DateTime @default(now()) @map("created_at")
  updatedAt    DateTime @updatedAt @map("updated_at")
  resumeUrl    String?  @map("resume_url")

  @@index([position])
  @@index([displayOrder])
  @@index([isActive])
  @@map("editorial_board_members")
}

model AdvisoryBoardMember {
  id           String   @id @default(uuid())
  name         String
  title        String?
  institution  String?
  email        String?
  bio          String?
  expertise    String?
  imageUrl     String?  @map("image_url")
  position     String?
  displayOrder Int      @default(0) @map("display_order")
  isActive     Boolean  @default(true) @map("is_active")
  joinedAt     DateTime @default(now()) @map("joined_at")
  createdAt    DateTime @default(now()) @map("created_at")
  updatedAt    DateTime @updatedAt @map("updated_at")
  resumeUrl    String?  @map("resume_url")

  @@index([displayOrder])
  @@index([isActive])
  @@map("advisory_board_members")
}

model ReviewerBoardMember {
  id           String   @id @default(uuid())
  name         String
  title        String?
  institution  String?
  email        String?
  bio          String?
  expertise    String?
  imageUrl     String?  @map("image_url")
  position     String?
  displayOrder Int      @default(0) @map("display_order")
  isActive     Boolean  @default(true) @map("is_active")
  joinedAt     DateTime @default(now()) @map("joined_at")
  createdAt    DateTime @default(now()) @map("created_at")
  updatedAt    DateTime @updatedAt @map("updated_at")
  resumeUrl    String?  @map("resume_url")

  @@index([displayOrder])
  @@index([isActive])
  @@map("reviewer_board_members")
}

model SubmissionGuideline {
  id           String   @id @default(uuid())
  title        String
  content      String
  category     String   @default("GENERAL")
  displayOrder Int      @default(0) @map("display_order")
  isPublished  Boolean  @default(true) @map("is_published")
  createdAt    DateTime @default(now()) @map("created_at")
  updatedAt    DateTime @updatedAt @map("updated_at")

  @@index([category])
  @@index([displayOrder])
  @@index([isPublished])
  @@map("submission_guidelines")
}

model PeerReviewProcess {
  id           String   @id @default(uuid())
  title        String
  content      String
  step         Int      @default(1)
  displayOrder Int      @default(0) @map("display_order")
  isPublished  Boolean  @default(true) @map("is_published")
  createdAt    DateTime @default(now()) @map("created_at")
  updatedAt    DateTime @updatedAt @map("updated_at")

  @@index([step])
  @@index([displayOrder])
  @@index([isPublished])
  @@map("peer_review_processes")
}

model Archive {
  id            String         @id @default(uuid())
  title         String
  description   String?
  volume        String?
  issue         String?
  year          Int
  coverImage    String?        @map("cover_image")
  pdfPath       String?        @map("pdf_path")
  isPublished   Boolean        @default(false) @map("is_published")
  publishedAt   DateTime?      @map("published_at")
  createdAt     DateTime       @default(now()) @map("created_at")
  updatedAt     DateTime       @updatedAt @map("updated_at")
  archivePapers ArchivePaper[]

  @@index([year])
  @@index([volume])
  @@index([issue])
  @@index([isPublished])
  @@index([publishedAt])
  @@map("archives")
}

model ArchivePaper {
  id        String   @id @default(uuid())
  archiveId String   @map("archive_id")
  paperId   String   @map("paper_id")
  pageStart Int?     @map("page_start")
  pageEnd   Int?     @map("page_end")
  createdAt DateTime @default(now()) @map("created_at")
  archive   Archive  @relation(fields: [archiveId], references: [id], onDelete: Cascade)
  paper     Paper    @relation(fields: [paperId], references: [id], onDelete: Cascade)

  @@unique([archiveId, paperId])
  @@index([archiveId])
  @@index([paperId])
  @@map("archive_papers")
}

model ChiefPatron {
  id            String   @id @default(cuid())
  name          String
  title         String
  institution   String?
  image_url     String?
  bio           String?
  display_order Int      @default(0)
  is_active     Boolean  @default(true)
  created_at    DateTime @default(now())
  updated_at    DateTime

  @@index([display_order])
  @@index([is_active])
  @@map("chief_patrons")
}

model DeploymentConfig {
  id         String   @id @default(uuid())
  host       String
  port       Int      @default(21)
  username   String
  password   String
  remotePath String   @map("remote_path")
  createdAt  DateTime @default(now()) @map("created_at")
  updatedAt  DateTime @updatedAt @map("updated_at")

  @@map("deployment_config")
}

model DeploymentLog {
  id        String   @id @default(uuid())
  type      String
  status    String
  message   String
  details   String?
  createdAt DateTime @default(now()) @map("created_at")

  @@index([type])
  @@index([status])
  @@index([createdAt])
  @@map("deployment_log")
}

model SupportTicket {
  id           String        @id @default(uuid())
  ticketNumber String        @unique @map("ticket_number")
  userId       String        @map("user_id")
  subject      String
  category     String
  priority     String        @default("MEDIUM")
  status       String        @default("OPEN")
  description  String
  createdAt    DateTime      @default(now()) @map("created_at")
  updatedAt    DateTime      @updatedAt @map("updated_at")
  user         User          @relation(fields: [userId], references: [id])
  replies      TicketReply[]

  @@index([userId])
  @@index([status])
  @@index([priority])
  @@index([category])
  @@index([createdAt])
  @@map("support_tickets")
}

model TicketReply {
  id         String        @id @default(uuid())
  ticketId   String        @map("ticket_id")
  userId     String        @map("user_id")
  message    String
  isInternal Boolean       @default(false) @map("is_internal")
  createdAt  DateTime      @default(now()) @map("created_at")
  ticket     SupportTicket @relation(fields: [ticketId], references: [id], onDelete: Cascade)
  user       User          @relation(fields: [userId], references: [id])

  @@index([ticketId])
  @@index([userId])
  @@index([createdAt])
  @@map("ticket_replies")
}

model ebook {
  id              String            @id @default(uuid())
  title           String
  author          String
  description     String?
  file_path       String
  coverImage      String?           @map("cover_image")
  access_type     String            @default("PUBLIC")
  trial_pages     Int               @default(5)
  total_pages     Int?
  price           Float?
  category        String?
  tags            String?
  isbn            String?
  scribdUrl       String?           @map("scribd_url")
  is_published    Boolean           @default(false)
  published_at    DateTime?
  createdAt       DateTime          @default(now()) @map("created_at")
  updatedAt       DateTime          @updatedAt @map("updated_at")
  created_by      String
  ebook_purchases ebook_purchases[]
  ebook_views     ebook_views[]
  users           User              @relation(fields: [created_by], references: [id])

  siteId String? @map("site_id")
  site   Site?   @relation(fields: [siteId], references: [id])

  @@index([siteId])
  @@index([category])
  @@index([access_type])
  @@index([created_by])
  @@index([is_published])
  @@index([published_at])
  @@map("ebooks")
}

model ebook_purchases {
  id           String    @id
  ebook_id     String
  user_id      String
  amount       Float
  currency     String    @default("USD")
  status       String    @default("PENDING")
  payment_id   String?
  purchased_at DateTime  @default(now())
  expires_at   DateTime?
  ebooks       ebook     @relation(fields: [ebook_id], references: [id], onDelete: Cascade)
  users        User      @relation(fields: [user_id], references: [id])

  @@unique([ebook_id, user_id])
  @@index([ebook_id])
  @@index([purchased_at])
  @@index([status])
  @@index([user_id])
}

model ebook_views {
  id          String   @id
  ebook_id    String
  user_id     String?
  ip_address  String?
  page_viewed Int
  viewed_at   DateTime @default(now())
  session_id  String?
  ebooks      ebook    @relation(fields: [ebook_id], references: [id], onDelete: Cascade)
  users       User?    @relation(fields: [user_id], references: [id])

  @@index([ebook_id])
  @@index([session_id])
  @@index([user_id])
  @@index([viewed_at])
}

model ImpactFactor {
  id              String   @id @default(uuid())
  year            Int
  value           Float
  certificatePath String?  @map("certificate_path")
  isActive        Boolean  @default(true) @map("is_active")
  createdAt       DateTime @default(now()) @map("created_at")
  updatedAt       DateTime @updatedAt @map("updated_at")
  createdBy       String   @map("created_by")
  creator         User     @relation("ImpactFactorCreator", fields: [createdBy], references: [id])

  siteId String? @map("site_id")
  site   Site?   @relation(fields: [siteId], references: [id])

  @@unique([year])
  @@index([siteId])
  @@index([year])
  @@index([isActive])
  @@index([createdBy])
  @@map("impact_factors")
}

model AnimationSettings {
  id            String    @id @default(uuid())
  animationType String    @unique @map("animation_type")
  isEnabled     Boolean   @default(false) @map("is_enabled")
  startDate     DateTime? @map("start_date")
  endDate       DateTime? @map("end_date")
  customMessage String?   @map("custom_message")
  createdAt     DateTime  @default(now()) @map("created_at")
  updatedAt     DateTime  @updatedAt @map("updated_at")

  @@index([isEnabled])
  @@index([animationType])
  @@map("animation_settings")
}

model TeamMember {
  id           String   @id @default(uuid())
  name         String
  title        String?
  role         String   @default("MEMBER")
  institution  String?
  email        String?
  bio          String?
  expertise    String?
  imageUrl     String?  @map("image_url")
  displayOrder Int      @default(0) @map("display_order")
  isActive     Boolean  @default(true) @map("is_active")
  joinedAt     DateTime @default(now()) @map("joined_at")
  createdAt    DateTime @default(now()) @map("created_at")
  updatedAt    DateTime @updatedAt @map("updated_at")

  @@index([role])
  @@index([displayOrder])
  @@index([isActive])
  @@map("team_members")
}

model Site {
  id           String   @id @default(uuid())
  name         String
  domain       String?
  abbreviation String
  isActive     Boolean  @default(true) @map("is_active")
  createdAt    DateTime @default(now()) @map("created_at")
  updatedAt    DateTime @updatedAt @map("updated_at")

  users         UserSiteAccess[]
  papers        Paper[]
  issues        Issue[]
  announcements Announcement[]
  conferences   Conference[]
  ebooks        ebook[]
  impactFactors ImpactFactor[]
  crossrefJournalSettings CrossrefJournalSettings?
  crossrefDeposits        CrossrefDeposit[]

  @@map("sites")
}

model UserSiteAccess {
  id        String   @id @default(uuid())
  userId    String   @map("user_id")
  siteId    String   @map("site_id")
  role      String // e.g. EDITOR, ADMIN for this specific site
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  site      Site     @relation(fields: [siteId], references: [id], onDelete: Cascade)
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  @@unique([userId, siteId])
  @@index([userId])
  @@index([siteId])
  @@map("user_site_access")
}

model ApiKey {
  id        String   @id @default(uuid())
  name      String
  key       String   @unique
  provider  String // e.g., 'sendgrid', 'stripe', 'aws'
  isActive  Boolean  @default(true) @map("is_active")
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")
  createdBy String   @map("created_by")

  @@index([provider])
  @@index([isActive])
  @@map("api_keys")
}

model ServiceRequest {
  id            String   @id @default(uuid())
  userId        String?
  fullName      String
  email         String
  phone         String
  affiliation   String?
  pubType       String
  title         String
  targetJournal String?
  description   String @default("")
  status        String @default("PENDING")
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  @@map("service_requests")
}

model CrossrefSettings {
  id              String   @id @default(uuid())
  publisherName   String   @map("publisher_name")
  publisherEmail  String   @map("publisher_email")
  doiPrefix       String   @map("doi_prefix")
  crossrefUser    String   @map("crossref_user")
  crossrefPass    String   @map("crossref_pass")
  environment     String   @default("production")
  depositorName   String   @map("depositor_name")
  depositorEmail  String   @map("depositor_email")
  autoDeposit     Boolean  @default(false) @map("auto_deposit")
  autoGenerateDoi Boolean  @default(false) @map("auto_generate_doi")
  retryFailed     Boolean  @default(false) @map("retry_failed")
  createdAt       DateTime @default(now()) @map("created_at")
  updatedAt       DateTime @updatedAt @map("updated_at")

  @@map("crossref_settings")
}

model CrossrefJournalSettings {
  id                   String   @id @default(uuid())
  siteId               String   @unique @map("site_id")
  site                 Site     @relation(fields: [siteId], references: [id], onDelete: Cascade)
  journalName          String   @map("journal_name")
  shortName            String   @map("short_name")
  issn                 String?
  eissn                String?
  publisher            String
  crossrefPrefix       String   @map("crossref_prefix")
  license              String?
  language             String?
  country              String?
  homepage             String?
  oaiEndpoint          String?  @map("oai_endpoint")
  publicationFrequency String?  @map("publication_frequency")
  copyright            String?
  openAccess           Boolean  @default(true) @map("open_access")
  peerReview           String?  @map("peer_review")
  createdAt            DateTime @default(now()) @map("created_at")
  updatedAt            DateTime @updatedAt @map("updated_at")

  @@map("crossref_journal_settings")
}

model CrossrefDeposit {
  id               String    @id @default(uuid())
  paperId          String    @unique @map("paper_id")
  siteId           String    @map("site_id")
  doi              String
  status           String    @default("READY")
  queueId          String?   @map("queue_id")
  xmlVersionId     String?   @map("xml_version_id")
  crossrefResponse String?   @map("crossref_response")
  retryCount       Int       @default(0) @map("retry_count")
  operatorId       String?   @map("operator_id")
  submissionTime   DateTime? @map("submission_time")
  completionTime   DateTime? @map("completion_time")
  createdAt        DateTime  @default(now()) @map("created_at")
  updatedAt        DateTime  @updatedAt @map("updated_at")
  
  paper            Paper     @relation(fields: [paperId], references: [id], onDelete: Cascade)
  site             Site      @relation(fields: [siteId], references: [id], onDelete: Cascade)
  operator         User?     @relation(fields: [operatorId], references: [id])
  logs             CrossrefLog[]

  @@index([status])
  @@index([siteId])
  @@index([operatorId])
  @@map("crossref_deposits")
}

model CrossrefLog {
  id         String   @id @default(uuid())
  depositId  String   @map("deposit_id")
  action     String
  details    String?
  status     String
  operatorId String?  @map("operator_id")
  createdAt  DateTime @default(now()) @map("created_at")
  
  deposit    CrossrefDeposit @relation(fields: [depositId], references: [id], onDelete: Cascade)
  operator   User?           @relation(fields: [operatorId], references: [id])

  @@index([depositId])
  @@index([createdAt])
  @@map("crossref_logs")
}

model CrossrefXmlVersion {
  id        String   @id @default(uuid())
  paperId   String   @map("paper_id")
  version   Int
  xmlData   String   @map("xml_data")
  createdAt DateTime @default(now()) @map("created_at")
  
  paper     Paper    @relation(fields: [paperId], references: [id], onDelete: Cascade)

  @@index([paperId])
  @@map("crossref_xml_versions")
}
